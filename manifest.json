{
  "manifest_version": 3,
  "name": "Flow Automation V0.1",
  "version": "0.1.0",
  "description": "Automatisation fiable et transparente de génération de contenu sur Google Flow. Prototype V0.1.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "*://flow.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Flow Automation",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://flow.google.com/*"
      ],
      "js": [
        "storage-manager.js",
        "flow-dom.js",
        "generation-manager.js",
        "download-manager.js",
        "queue-manager.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
}
