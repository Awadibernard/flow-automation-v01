{
  "manifest_version": 3,
  "name": "Flow Automation V0.1.6",
  "version": "0.1.6",
  "description": "Automatisation fiable et transparente de génération de contenu sur Google Flow. Prototype V0.1.6 (actuation CDP optionnelle, compatibilité Quetta Android).",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "scripting",
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "*://flow.google.com/*",
    "*://*.googleusercontent.com/*",
    "*://*.googleapis.com/*",
    "*://*.googlevideo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flow Automation",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://flow.google.com/*"
      ],
      "js": [
        "status.js",
        "storage-manager.js",
        "flow-dom.js",
        "generation-manager.js",
        "download-manager.js",
        "queue-manager.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "selectors.json"
      ],
      "matches": [
        "*://flow.google.com/*"
      ]
    }
  ],
  "icons": {}
}
