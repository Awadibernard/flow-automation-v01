{
  "version": 1,
  "note": "Sélecteurs locaux pour Google Flow. Version 1 = hypothèses basées sur la structure Angular/Material du site et l'analyse de l'extension d'origine. À VALIDER sur le site réel (navigateur connecté) avant toute mise en production. Le champ 'confidence' indique le niveau de fiabilité estimé.",
  "app": {
    "hostPattern": "flow.google.com",
    "projectPathPattern": "/project/"
  },
  "selectors": {
    "promptTextarea": {
      "value": "div[contenteditable='true'][role='textbox']",
      "confidence": "medium",
      "source": "analyse extension originale + framework Angular (contenteditable + role textbox)"
    },
    "submitButton": {
      "value": "button[jsaction*='submit'], button[aria-label*='Create' i], button[aria-label*='Generate' i], button[data-test-id*='submit' i]",
      "confidence": "low",
      "source": "à valider manuellement"
    },
    "generatingIndicator": {
      "value": "flow-progress-indicator, [class*='progress'], [role='progressbar']",
      "confidence": "low",
      "source": "à valider manuellement"
    },
    "resultTiles": {
      "value": "flow-tile, [class*='tile'], [class*='result']",
      "confidence": "low",
      "source": "à valider manuellement"
    },
    "tileMedia": {
      "value": "video, img",
      "confidence": "medium",
      "source": "les médias sont des <video>/<img> dans les tuiles"
    },
    "projectNameInput": {
      "value": "input[placeholder*='Name' i]",
      "confidence": "low",
      "source": "à valider manuellement"
    },
    "createProjectButton": {
      "value": "button[aria-label*='New project' i], button[aria-label*='Create project' i]",
      "confidence": "low",
      "source": "à valider manuellement"
    }
  },
  "options": {
    "model": {
      "selectorTemplate": "flow-select-option, mat-option",
      "optionMatch": "textContent",
      "confidence": "low",
      "source": "à valider manuellement"
    },
    "aspectRatio": {
      "selectorTemplate": "flow-select-option, mat-option",
      "optionMatch": "textContent",
      "confidence": "low",
      "source": "à valider manuellement"
    },
    "outputCount": {
      "selectorTemplate": "flow-select-option, mat-option",
      "optionMatch": "textContent",
      "confidence": "low",
      "source": "à valider manuellement"
    }
  },
  "durations": {
    "generationTimeoutMs": 180000,
    "pollIntervalMs": 2000,
    "tileStabilityChecks": 3,
    "tileStabilityDelayMs": 1500
  }
}
